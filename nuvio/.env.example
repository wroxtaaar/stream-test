# Copy to .env before starting. Never commit the real .env.
PORT=7000
TMDB_API_KEY=replace_with_your_tmdb_api_key

# Optional: leave blank unless you have configured a proxy you trust.
SHOWBOX_PROXY_URL_VALUE=
SHOWBOX_PROXY_URL_ALTERNATE=

# Cache is enabled when these are false.
DISABLE_CACHE=false
DISABLE_STREAM_CACHE=false
USE_REDIS_CACHE=false

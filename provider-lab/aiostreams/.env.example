# Copy this file to .env and set a unique 64-character hexadecimal SECRET_KEY.
# Generate one on the VPS with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32

# Use localhost for initial setup through an SSH tunnel.
# For public Stremio use, configure HTTPS and set BASE_URL to your HTTPS URL.
BASE_URL=http://localhost:3002
PORT=3000
LOG_LEVEL=info

{
  "name": "vidcore-stream-resolver-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "rm -rf dist && tsc -p tsconfig.web.json && mkdir -p dist/styles && cp web/index.html dist/ && cp web/styles/app.css dist/styles/",
    "start": "npm run build:web && tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
